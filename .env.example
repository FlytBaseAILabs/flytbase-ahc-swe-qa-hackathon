# Copy to .env and adjust. Every value has a working default; docker compose
# reads this file automatically.

# --- Backend ---
SIM_SHARED_SECRET=sim-secret            # simulator <-> backend socket handshake secret
ORG_ID=flytbase                         # org id used in every telemetry topic
CORS_ORIGIN=*                           # browser origins allowed to call the backend

# --- Simulator ---
SIM_DRONES=4                            # dock+drone pairs at boot (add more from the control panel)
SIM_SEED=42                             # RNG seed; same seed = same run
SIM_SPEED=1                             # simulated-time multiplier (10 = ten times faster)
SIM_TICK_MS=500                         # wall-clock tick interval
SIM_AUTOSTART=true                      # publish telemetry immediately on boot

# --- Video ---
VIDEO_AUTOSTART=true                    # backend starts one video stream per drone at boot
# VIDEO_SAMPLE_FILES=/samples/sample-1.mp4,/samples/sample-2.mp4   # clips inside the video container; drones rotate through the list

# --- Host-facing URLs (what the browser uses) ---
API_URL=http://localhost:4000           # backend as seen from the browser
WHEP_URL=http://localhost:8889          # MediaMTX WHEP endpoint as seen from the browser
MAP_TILES=google                        # google | osm, both keyless, need internet
MAP_TERRAIN=world                       # world (Cesium World Terrain, falls back to flat) | flat
# CESIUM_ION_TOKEN=                     # optional; empty uses the token bundled with CesiumJS
